# Google Gemini API Key (Required for Phase 1 code summaries/embeddings and Phase 3 multi-agent reasoning)
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Neo4j Graph Database Configuration
# If Neo4j is not running, the application will automatically use an in-memory graph fallback
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Qdrant Vector Database Configuration
# Leave as :memory: for embedded zero-setup vector database, or provide remote URL (e.g. http://localhost:6333)
QDRANT_URL=:memory:
QDRANT_API_KEY=
QDRANT_COLLECTION=codebase_symbols
